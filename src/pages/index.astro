---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_NAME, SITE_DESCRIPTION, SITE_URL } from '../consts';

const posts = (await getCollection('posts')).sort(
  (a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: SITE_URL,
  description: SITE_DESCRIPTION,
};
---

<Base title="Home" description={SITE_DESCRIPTION} path="/" jsonLd={jsonLd}>
  <section class="hero">
    <h1>What is climbing right now — and which tool you should actually pick.</h1>
    <p class="lede">
      We track developer tools that are gaining momentum, check the claims around them, and
      publish one verdict at a time. Difficulty scores, SERP reality, and sources ship with
      every entry — so you can check our work instead of trusting it.
    </p>
    <p class="method-note">
      <a href="/method/">READ THE TOPIC METHOD →</a>&nbsp;&nbsp;no affiliate links · corrections in public · no invented numbers
    </p>
  </section>

  <div class="section-head">
    <h2>Observation log</h2>
    <a class="more" href="/posts/">All entries →</a>
  </div>

  {posts.map((post, i) => (
    <PostCard
      href={`/posts/${post.id}/`}
      title={post.data.title}
      description={post.data.description}
      obs={i + 1}
      date={post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
      kd={post.data.kd ? post.data.kd.match(/KD (\d+)/)?.[1] : undefined}
      spark={[0.1, 0.18, 0.14, 0.3, 0.26, 0.44, 0.4, 0.58, 0.72, 0.9]}
    />
  ))}
</Base>
