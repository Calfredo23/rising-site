---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import KDMeter from '../../components/KDMeter.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts').then((list) =>
    list.sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf())
  );
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, obs: i + 1 },
  }));
}

const { post, obs } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, tags, query } = post.data;
const kdNumber = post.data.kd ? parseInt(post.data.kd.match(/KD (\d+)/)?.[1] ?? '', 10) : undefined;

const SITE = 'https://rising-site.catimbangcedrickalfredo.workers.dev';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description: description,
    datePublished: pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? pubDate).toISOString(),
    author: { '@type': 'Organization', name: 'On the Rise', url: SITE },
    mainEntityOfPage: `${SITE}/posts/${post.id}/`,
    keywords: tags.join(', '),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'Posts', item: `${SITE}/posts/` },
      { '@type': 'ListItem', position: 3, name: title },
    ],
  },
];
---

<Base title={title} description={description} path={`/posts/${post.id}/`} type="article" publishedTime={pubDate} jsonLd={jsonLd}>
  <article class="prose">
    <div class="entry-head">
      <span class="obs-line"><b>OBS-{String(obs).padStart(3, '0')}</b> · {pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
      <span class="stamp stamp-rise">▲ verdict</span>
    </div>
    <h1>{title}</h1>
    <p class="post-meta">
      <span class="k">TARGET QUERY</span> {query}
      <span class="sep">|</span>
      {post.data.kd && <span><span class="k">MEASURED</span> {post.data.kd}</span>}
    </p>
    {kdNumber !== undefined && !Number.isNaN(kdNumber) && <KDMeter kd={kdNumber} />}
    <Content />
  </article>
</Base>
