---
import { SITE_NAME, SITE_TAGLINE, SITE_URL, GITHUB_URL } from '../consts';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  jsonLd?: object | object[];
  noindex?: boolean;
}

const { title, description, path = '/', type = 'website', publishedTime, jsonLd, noindex } = Astro.props;
const canonical = new URL(path, SITE_URL).href;
const fullTitle = path === '/' ? `${SITE_NAME} — rising dev tools, verdicted weekly` : `${title} | ${SITE_NAME}`;
const ogImage = new URL('/og.svg', SITE_URL).href;

const blocks: object[] = [];
if (jsonLd) {
  if (Array.isArray(jsonLd)) blocks.push(...jsonLd);
  else blocks.push(jsonLd);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex' : 'index, follow'} />
    <meta name="theme-color" content="#0f172a" />
    <meta name="google-site-verification" content="6wQ2ryMMQKTr2rH5kgqg8wjE7E3tqunNfuB8vrUWeT0" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={new URL('/rss.xml', SITE_URL).href} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {blocks.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href="/" class="brand">{SITE_NAME}<span class="brand-dot">▲</span></a>
        <nav aria-label="Main">
          <a href="/">Home</a>
          <a href="/posts/">Posts</a>
          <a href="/method/">Method</a>
          <a href="/about/">About</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>{SITE_NAME} — {SITE_TAGLINE}</p>
        <p>
          <a href="/method/">How we pick topics</a> · <a href="/rss.xml">RSS</a> ·
          <a href={GITHUB_URL} rel="noopener">GitHub</a>
        </p>
      </div>
    </footer>
  </body>
</html>
