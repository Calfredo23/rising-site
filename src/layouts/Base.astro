---
import { SITE_NAME, SITE_URL, GITHUB_URL } from '../consts';
import Sparkline from '../components/Sparkline.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  jsonLd?: object | object[];
  noindex?: boolean;
}

const { title, description, path = '/', type = 'website', publishedTime, jsonLd, noindex } = Astro.props;
const canonical = new URL(path, SITE_URL).href;
const fullTitle = path === '/' ? `${SITE_NAME} — rising dev tools, verdicted weekly` : `${title} | ${SITE_NAME}`;
const ogImage = new URL('/og.svg', SITE_URL).href;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/posts/', label: 'Posts' },
  { href: '/method/', label: 'Method' },
  { href: '/about/', label: 'About' },
];

const blocks: object[] = [];
if (jsonLd) {
  if (Array.isArray(jsonLd)) blocks.push(...jsonLd);
  else blocks.push(jsonLd);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex' : 'index, follow'} />
    <meta name="theme-color" content="#101820" />
    <meta name="google-site-verification" content="6wQ2ryMMQKTr2rH5kgqg8wjE7E3tqunNfuB8vrUWeT0" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={new URL('/rss.xml', SITE_URL).href} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=IBM+Plex+Mono:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />

    {blocks.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
  </head>
  <body>
    <header class="masthead">
      <div class="wrap">
        <a href="/" class="brand">
          <span class="word">{SITE_NAME} ▲</span>
          <span class="sub">Observation log · vol. 1</span>
        </a>
        <div class="masthead-spark">
          <Sparkline width={210} height={34} points={[0.08, 0.14, 0.1, 0.24, 0.2, 0.38, 0.34, 0.52, 0.66, 0.6, 0.82, 0.95]} color="#5fd08a" />
        </div>
      </div>
    </header>

    <nav class="site-nav" aria-label="Main">
      <div class="wrap">
        {nav.map((item) => (
          <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
        ))}
      </div>
    </nav>

    <div class="ticker" role="presentation">
      <div class="wrap">
        <span class="up">▲ 3 TOOLS TRACKED</span>
        <span>5 VERDICTS SHIPPED · 0 CORRECTIONS NEEDED</span>
        <span class="hot">NEXT SCAN: MONDAY</span>
        <span>EST. LAUNCH 2026-09-06</span>
      </div>
    </div>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p class="foot-brand">{SITE_NAME} ▲ — {SITE_URL.replace('https://', '')}</p>
        <p><a href="/method/">How we pick topics</a> · <a href="/rss.xml">RSS</a> · <a href={GITHUB_URL} rel="noopener">GitHub</a> · built with <a href="https://astro.build" rel="noopener">Astro</a></p>
      </div>
    </footer>
  </body>
</html>
